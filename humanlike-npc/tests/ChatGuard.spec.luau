return function(T, Loader)
	local session = Loader.new()
	local ChatGuard = session.require(session.game.ServerStorage.HumanlikeNpc.Chat.ChatGuard)

	T.describe("ChatGuard", function()
		T.it("min gap 4 s", function()
			local guard = ChatGuard.new()
			T.check(guard:allow("npc1", 0))
			T.check(not guard:allow("npc1", 3.9), "3.9 s after the last line is too soon")
			T.equal(guard:dropped(), 1)
			T.check(guard:allow("npc1", 4.0), "4 s after the last line is fine")
			T.check(guard:allow("npc2", 4.5), "another NPC has its own gap")
			T.equal(guard:dropped(), 1)
		end)

		T.it("four per minute then blocked", function()
			local guard = ChatGuard.new()
			for i = 0, 3 do
				T.check(guard:allow("npc1", i * 4), `line {i + 1}`)
			end
			T.check(not guard:allow("npc1", 30), "5th line in the minute")
			T.check(not guard:allow("npc1", 59), "still 4 in the window")
			T.check(guard:allow("npc1", 60.5), "the first line fell out of the window")
			T.equal(guard:dropped(), 2)
		end)

		T.it("twelve per ten minutes", function()
			local guard = ChatGuard.new()
			for k = 0, 11 do
				T.check(guard:allow("npc1", k * 15), `line {k + 1}`)
			end
			T.check(not guard:allow("npc1", 180), "13th line in ten minutes")
			T.check(guard:allow("npc1", 600.5), "the first line fell out of the ten minute window")
		end)

		T.it("reply boost allows 6", function()
			local guard = ChatGuard.new()
			for i = 0, 3 do
				T.check(guard:allow("npc1", i * 4))
			end
			T.check(not guard:allow("npc1", 16), "spontaneous 5th blocked")
			T.check(guard:allow("npc1", 16, true), "reply 5")
			T.check(guard:allow("npc1", 20, true), "reply 6")
			T.check(not guard:allow("npc1", 24, true), "reply 7 exceeds the boost")
			T.check(not guard:allow("npc1", 24), "spontaneous still blocked")
			T.check(not guard:allow("npc1", 22, true), "the gap still applies to replies")
		end)

		T.it("server cap 8/min across npcs", function()
			local guard = ChatGuard.new()
			for i = 1, 8 do
				T.check(guard:allow(`npc{i}`, i), `npc {i}`)
			end
			T.check(not guard:allow("npc9", 9), "9th line server-wide")
			T.check(not guard:allow("npc9", 9, true), "a reply never bypasses the server cap")
			T.equal(guard:stats(9).server1m, 8)
			T.equal(guard:stats(9).players1m, 0)
			T.check(guard:allow("npc9", 61.5), "the oldest line fell out of the window")
			T.equal(guard:dropped(), 2)
		end)

		T.it("share rule", function()
			local guard = ChatGuard.new()
			guard:onPlayerLine(0)
			guard:onPlayerLine(1)
			T.check(guard:allow("npc1", 2), "1 of 3 lines")
			T.check(guard:allow("npc2", 3), "2 of 4 lines")
			T.check(not guard:allow("npc3", 4), "players 2 / NPCs 2: a third NPC line is blocked")
			T.equal(guard:dropped(), 1)
			guard:onPlayerLine(5)
			T.check(guard:allow("npc3", 6), "players 3 / NPCs 2: allowed")
			T.check(not guard:allow("npc4", 7), "players 3 / NPCs 3: 4 <= ceil(2.8) fails")
			T.check(guard:allow("npc4", 7, true), "a reply skips the share rule")
			T.equal(guard:stats(7).server1m, 4)
			T.equal(guard:stats(7).players1m, 3)
			-- No player line in the last minute: rule 5 is skipped and the server is not yet quiet.
			T.equal(guard:stats(70).players1m, 0)
			T.check(guard:allow("npc5", 70), "no player line in 60 s, 65 s since the last one")
			-- 600 s after the last player line rule 5b decides instead.
			T.check(guard:allow("npc6", 605))
			T.check(guard:allow("npc7", 606))
			T.check(not guard:allow("npc8", 607), "quiet server: quarter rate")
		end)

		T.it("quiet server quarter rate", function()
			local guard = ChatGuard.new()
			T.check(guard:allow("npc1", 601))
			T.check(guard:allow("npc2", 602))
			T.check(not guard:allow("npc3", 603), "2 lines per minute on a quiet server")
			T.check(guard:allow("npc3", 603, true), "replies are not quieted")
			T.check(not guard:allow("npc4", 640))
			T.check(guard:allow("npc4", 662), "a new minute")
			guard:onPlayerLine(700)
			T.check(guard:allow("npc5", 701), "a player line wakes the server")

			-- The silence timer starts at construction, not at 0.
			local late = ChatGuard.new(nil, 1000)
			T.check(late:allow("npc1", 1500))
			T.check(late:allow("npc2", 1501))
			T.check(late:allow("npc3", 1502), "not yet quiet 502 s after start")
			T.check(late:allow("npc1", 1601))
			T.check(late:allow("npc2", 1602))
			T.check(not late:allow("npc3", 1603), "quiet 601 s after start")
		end)

		T.it("forget clears", function()
			local guard = ChatGuard.new()
			for i = 0, 3 do
				T.check(guard:allow("npc1", i * 4))
			end
			T.check(not guard:allow("npc1", 13))
			guard:forget("npc1")
			T.check(guard:allow("npc1", 13), "no history: no gap and no per-minute count")
			T.equal(guard:stats(13).server1m, 5, "server-wide counts keep what was said")
		end)

		T.it("options override the defaults", function()
			T.equal(ChatGuard.DEFAULTS.npcMinGap, 4)
			T.equal(ChatGuard.DEFAULTS.serverShare, 0.4)
			local guard = ChatGuard.new({ npcMinGap = 1, npcPerMinute = 2, serverPerMinute = 3 })
			T.check(guard:allow("npc1", 0))
			T.check(not guard:allow("npc1", 0.5), "1 s gap")
			T.check(guard:allow("npc1", 1))
			T.check(not guard:allow("npc1", 2), "2 per minute")
			T.check(guard:allow("npc2", 2))
			T.check(not guard:allow("npc3", 3), "3 per minute server-wide")
		end)
	end)
end
