return function(T, Loader)
	local session = Loader.new()
	local S = session.game.ServerStorage.HumanlikeNpc
	local Scheduler = session.require(S.Runtime.Scheduler)

	T.describe("Scheduler additions", function()
		T.it("keeps the frozen defaults and fills missing params from them", function()
			local d = Scheduler.DEFAULTS
			T.equal(d.near, 60)
			T.equal(d.mid, 200)
			T.equal(d.far, 500)
			T.equal(d.hysteresis, 1.25)
			T.equal(d.rates.near, 10)
			T.equal(d.rates.dormant, 0.5)
			T.equal(d.brainDivisor.near, 5)
			T.equal(d.maxTicksPerFrame, 8)
			local partial = Scheduler.new({ rates = { near = 20 }, brainDivisor = { near = 2 }, maxTicksPerFrame = 12 })
			T.equal(partial.params.rates.near, 20)
			T.equal(partial.params.rates.mid, 5, "unlisted rate keeps its default")
			T.equal(partial.params.brainDivisor.near, 2)
			T.equal(partial.params.brainDivisor.dormant, 1)
			T.equal(partial.params.near, 60)
			T.equal(partial.params.maxTicksPerFrame, 12)
			T.equal(Scheduler.DEFAULTS.rates.near, 10, "DEFAULTS untouched by a partial constructor")
			T.equal(Scheduler.new().params.maxTicksPerFrame, 8)
		end)

		T.it("wake makes an npc due now with a brain tick", function()
			local scheduler = Scheduler.new()
			scheduler:add("a", 0, 0)
			scheduler:add("b", 0, 0)
			T.equal(#scheduler:due(0), 2, "both due at their phase-0 start")
			T.equal(scheduler:markTicked("a", 0), false, "first tick is not a brain tick (divisor 5)")
			T.equal(#scheduler:due(0.02), 1, "a is not due again for ~0.1 s")
			scheduler:wake("a", 0.02)
			local due = scheduler:due(0.02)
			T.equal(#due, 2)
			T.equal(due[1], "a", "the woken npc comes first, ahead of an older due one")
			T.equal(due[2], "b")
			T.equal(scheduler:markTicked("a", 0.02), true, "the woken tick runs the brain")
			T.equal(scheduler:markTicked("a", 0.12), false, "the wake is consumed by one tick")
			T.equal(scheduler:markTicked("a", 0.22), false)
			T.equal(scheduler:markTicked("a", 0.32), true, "divisor cadence continues: 5th tick")
			scheduler:wake("nobody", 1) -- unknown id: no error, nothing added
			T.equal(scheduler:count(), 2)
		end)

		T.it("wake pulls a dormant npc out of its 2-s period", function()
			local scheduler = Scheduler.new()
			scheduler:add("a", 0.5, 0)
			scheduler:assignTiers({ a = 1000 })
			T.equal(scheduler:tierOf("a"), "dormant")
			scheduler:markTicked("a", 1)
			T.equal(#scheduler:due(1.5), 0, "dormant ticks every 2 s")
			scheduler:wake("a", 1.5)
			T.equal(scheduler:due(1.5)[1], "a")
			T.equal(scheduler:markTicked("a", 1.5), true)
			T.equal(#scheduler:due(1.6), 0, "after the woken tick the dormant period applies again")
		end)

		T.it("setTier bypasses hysteresis", function()
			local scheduler = Scheduler.new()
			scheduler:add("a", 0.5, 0)
			scheduler:assignTiers({ a = 70 })
			T.equal(scheduler:tierOf("a"), "near", "70 is inside the near band from near")
			T.equal(scheduler:setTier("a", "mid"), true)
			T.equal(scheduler:tierOf("a"), "mid")
			scheduler:assignTiers({ a = 70 })
			T.equal(scheduler:tierOf("a"), "mid", "assignTiers keeps the tier setTier chose")
			T.equal(scheduler:setTier("a", "mid"), false, "no change reported for the same tier")
			T.equal(scheduler:setTier("a", "near"), true)
			scheduler:assignTiers({ a = 70 })
			T.equal(scheduler:tierOf("a"), "near", "back inside the near band, hysteresis holds")
			T.equal(scheduler:setTier("a", "bogus"), false, "a tier with no rate is ignored")
			T.equal(scheduler:tierOf("a"), "near")
			T.equal(scheduler:setTier("zz", "far"), false, "unknown id is ignored")
			T.equal(scheduler:count(), 1)
			-- A promotion also pulls the next tick forward to the new period.
			scheduler:setTier("a", "dormant")
			scheduler:markTicked("a", 10)
			T.equal(#scheduler:due(10.5), 0)
			scheduler:setTier("a", "near")
			T.equal(scheduler:due(10.5)[1], "a", "due at the near period after promotion")
			local brainTicks = 0
			for i = 1, 10 do
				if scheduler:markTicked("a", 10.5 + i * 0.1) then
					brainTicks += 1
				end
			end
			T.equal(brainTicks, 2, "brain divisor follows the tier setTier chose")
		end)
	end)
end
